# ── Krator+ / startflix server environment ─────────────────────────

# PostgreSQL connection string used by Prisma and the pg pool.
# On Coolify use the database's INTERNAL url.
DATABASE_URL=postgres://user:password@host:5432/startflix

# Port the Express server listens on (Coolify maps this).
PORT=3001

NODE_ENV=production

# Static key required in the Authorization header for every /api/admin/* route.
# Set a long random value in production. Defaults to "master2024" if unset.
ADMIN_KEY=change-me-to-a-long-random-string

# Optional: TMDB v4 read access token for movie/series posters & metadata.
# The app works without it (falls back to M3U logos).
TMDB_TOKEN=

# Optional: origin of a plain-HTTP-only domain (no TLS, no forced https
# redirect) pointed at this SAME app in Coolify, e.g. http://play.appbr.pro.
# Enables the GET /watch escape hatch for live channels whose upstream CDN
# has no TLS — those can't play inside the main https:// app (mixed content),
# but can play with zero server bandwidth from a plain-http page. Leave unset
# to hide the feature entirely. See docs/http-watch-domain.md.
HTTP_WATCH_ORIGIN=
